# Tip: on a fresh server, `sudo bash deploy/install.sh` asks a few questions and writes this file for you.

# ── Runtime ───────────────────────────────────────────────
# Domain pointed (A record) at this server; Caddy gets an HTTPS certificate for it.
DOMAIN=wallet.example.com
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# true behind a reverse proxy (the bundled Caddy, nginx, Cloudflare) so client IPs are correct.
TRUST_PROXY=true

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgres://wallet:change-me@localhost:5432/wallet
# Used by docker-compose for the bundled Postgres.
POSTGRES_PASSWORD=change-me

# ── Telegram ──────────────────────────────────────────────
# Token from @BotFather. Also used to verify Mini App initData signatures.
BOT_TOKEN=
# polling (simple, single instance) | webhook (recommended in production) | off
BOT_MODE=webhook
# Random 16–256 chars [A-Za-z0-9_-]; Telegram sends it back in a header on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS address of this server, e.g. https://wallet.example.com
PUBLIC_URL=
# Mini App URL opened by the bot's buttons (usually the same as PUBLIC_URL).
WEBAPP_URL=
# How long a Mini App session (initData) stays valid, seconds.
INIT_DATA_MAX_AGE_SEC=86400

# ── Payments ──────────────────────────────────────────────
# cryptopay (real money via @CryptoBot) | mock (local development only; refused in production)
PAYMENT_PROVIDER=cryptopay
# Token from @CryptoBot → Crypto Pay → Create App (or @CryptoTestnetBot for testnet).
CRYPTOPAY_TOKEN=
# testnet | mainnet
CRYPTOPAY_NETWORK=testnet
# Enabled currencies, comma separated (limits and fees: server/src/domain/assets.ts).
# Fiat (RUB, USD, EUR, CNY) is funded with fiat-priced invoices paid in crypto and withdrawn as USDT.
ASSETS=RUB,USD,EUR,CNY,TON
# Spread on currency exchange and on fiat withdrawals, in basis points (100 = 1%).
EXCHANGE_FEE_BPS=100
# How long the app stays unlocked after entering the PIN, seconds.
SESSION_TTL_SEC=1800

# ── Protection ────────────────────────────────────────────
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_SENSITIVE_PER_MIN=10
